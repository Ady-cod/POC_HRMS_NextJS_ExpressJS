# Environment variables declared in the .env file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Below you can find the examples for the environment variables used in this project backend.
# *** Copy them to YOUR OWN .env FILE ***, in the root of the backend folder, and replace the placeholder values with your own values.
# IMPORTANT: Ensure that your `.env` file is not included in version control for security.

# PostgreSQL connection strings (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public&connection_limit=5&pool_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public"

# MongoDB connection string (for migration script reads)
MONGO_DATABASE_URL="mongodb://localhost:27017/YOUR_DATABASE_NAME" # Replace 'YOUR_DATABASE_NAME' with the actual database name.

# If your MongoDB is running on a different port, replace '27017' with the actual port number.
# If your MongoDB requires authentication, use the format:
# MONGO_DATABASE_URL="mongodb://username:password@localhost:27017/YOUR_DATABASE_NAME". Replace 'username', 'password', and 'YOUR_DATABASE_NAME' with the actual values.

# If you are using MongoDB Atlas, use the connection string provided by MongoDB Atlas in the format:
# MONGO_DATABASE_URL="mongodb+srv://<cluster_username>:<cluster_password>@cluster0.e7o7d.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=<cluster_name>"
# Replace '<cluster_username>', '<cluster_password>', and '<database_name>', with the actual values.
# The connection string will be provided by MongoDB Atlas in the format above, you just need to replace the placeholders with the actual values.
# The database name will be inserted in the connection string, as shown above, after the last '/'.

# Optional DNS override for email domain validation (dev only)
# Example: DNS_SERVERS="1.1.1.1,8.8.8.8"
DNS_SERVERS=

# Email domain validation mode: strict | warn | off
# strict: DNS failures reject the email
# warn: DNS failures allow with warning logs
# off: skip DNS checks entirely
EMAIL_DOMAIN_VALIDATION_MODE=warn

# Server port
PORT=5000 # Replace '5000' with the port number if different, default is usually 3000 but this is likely to be in use by the frontend.

# JWT secret key example. 
JWT_SECRET=your_jwt_secret_here

# The JWT secret key is used to sign and verify JWT tokens for authentication and authorization and is usually a long random string.
# You can generate a secret key by running the CLI command in a Bash terminal: openssl rand -base64 32
# Copy the output and replace 'your_jwt_secret_here' with the generated secret key.

# Example of a generated secret key: DnldKnxA1mRXVLmhjtYe2b29Qj5sakiVRcckx2COayQ=